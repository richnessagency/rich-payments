{
    "name": "richnessagency/rich-payments",
    "description": "Plug and play Laravel payment gateway package with encrypted database settings, ready views, and Paymob support.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "payments", "paymob", "gateway", "checkout"],
    "authors": [
        {
            "name": "Richness Agency",
            "homepage": "https://github.com/richnessagency"
        }
    ],
    "support": {
        "issues": "https://github.com/richnessagency/rich-payments/issues",
        "source": "https://github.com/richnessagency/rich-payments"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/encryption": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Richness\\RichPayments\\": "src/",
            "Richness\\RichPayments\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Richness\\RichPayments\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Richness\\RichPayments\\RichPaymentsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
